{%- comment -%}
  갤러리 페이지 본문 (영문/국문 공용).
  내용: _gallery_items/ 폴더 (사진 1장 = 파일 1개), 사진 파일은 assets/img/gallery/
{%- endcomment -%}
{%- assign lang = include.lang | default: 'en' -%}
{%- assign t = site.data.i18n[lang] -%}
{%- assign gal = site.gallery_items | sort: 'date' | reverse -%}

<div class="cv-tools">
  <a class="admin-only pub-add" href="#" data-open-gallery-admin><i class="fa-solid fa-plus"></i> {% if lang == 'ko' %}사진 추가{% else %}Add photo{% endif %}</a>
</div>

{% if gal.size > 0 %}
<div class="gallery-grid">
  {%- for g in gal %}
  {%- if lang == 'ko' and g.caption_ko and g.caption_ko != "" -%}{%- assign cap = g.caption_ko -%}{%- else -%}{%- assign cap = g.caption -%}{%- endif %}
  {%- if g.image contains '://' -%}{%- assign src = g.image -%}{%- else -%}{%- assign src = g.image | relative_url -%}{%- endif %}
  <figure class="gallery-item">
    {% include item_tools.liquid path=g.relative_path image=g.image label=cap %}
    <a href="{{ src }}" data-lightbox="gallery" data-title="{{ cap | escape }}">
      <img src="{{ src }}" alt="{{ cap | default: 'Gallery photo' | escape }}" loading="lazy">
    </a>
    {%- if cap or g.date %}
    <figcaption>
      {{ cap }}
      {%- if g.date %}<small>{% if g.category and g.category != "" %}{{ g.category }} · {% endif %}{% if lang == 'ko' %}{{ g.date | date: "%Y년 %-m월" }}{% else %}{{ g.date | date: "%B %Y" }}{% endif %}</small>{% endif %}
    </figcaption>
    {%- endif %}
  </figure>
  {%- endfor %}
</div>
{% else %}
<div class="gallery-empty">
  <i class="fa-regular fa-images"></i>
  <p>{{ t.gallery_empty }}</p>
</div>
{% endif %}

{%- assign ko = false -%}{%- if lang == 'ko' -%}{%- assign ko = true -%}{%- endif -%}
<dialog id="galleryAdmin" class="pa-dialog" data-repo="{{ site.github_repo }}" data-branch="{{ site.github_branch | default: 'main' }}" data-lang="{{ lang }}">
  <form method="dialog" class="pa-form" id="galleryAdminForm">
    <header class="pa-head">
      <h3>{% if ko %}사진 추가{% else %}Add a photo{% endif %}</h3>
      <button type="button" class="pa-x" data-close aria-label="Close">&times;</button>
    </header>
    <fieldset class="pa-fields">
      <label class="pa-wide">{% if ko %}사진 파일 선택 (영문·숫자 파일 이름 권장){% else %}Photo file (use a simple English file name){% endif %} *
        <input name="file" type="file" accept="image/*" required></label>
      <div class="pa-wide pa-thumb" hidden><img alt=""></div>
      <label class="pa-wide">{% if ko %}설명 (영문){% else %}Caption (English){% endif %}<input name="caption" placeholder="IGARSS 2026, Taipei"></label>
      <label class="pa-wide">{% if ko %}설명 (국문){% else %}Caption (Korean){% endif %}<input name="caption_ko" placeholder="IGARSS 2026 발표"></label>
      <label>{% if ko %}날짜{% else %}Date{% endif %} *<input name="date" type="date" required></label>
      <label>{% if ko %}분류{% else %}Category{% endif %}
        <select name="category"><option value="">-</option><option>Conference</option><option>Fieldwork</option><option>Lab</option><option>Award</option><option>Event</option></select></label>
    </fieldset>

    <ol class="pa-steps">
      <li>
        <strong>{% if ko %}1단계 · 사진 올리기{% else %}Step 1 · Upload the photo{% endif %}</strong>
        <span>{% if ko %}GitHub 업로드 화면이 열리면 선택한 사진을 끌어다 놓고 <b>Commit changes</b>.{% else %}Drag the selected photo into GitHub's upload page and click <b>Commit changes</b>.{% endif %}</span>
        <button type="button" class="pa-btn" data-step="upload">{% if ko %}GitHub 업로드 열기{% else %}Open GitHub upload{% endif %} <i class="fa-brands fa-github"></i></button>
      </li>
      <li>
        <strong>{% if ko %}2단계 · 사진 설명 등록{% else %}Step 2 · Save the caption{% endif %}</strong>
        <span>{% if ko %}새 파일 화면이 내용이 채워진 채로 열립니다 → <b>Commit changes</b>.{% else %}A new-file page opens pre-filled → <b>Commit changes</b>.{% endif %}</span>
        <button type="submit" class="pa-btn primary">{% if ko %}설명 저장 (GitHub){% else %}Save caption (GitHub){% endif %} <i class="fa-brands fa-github"></i></button>
      </li>
    </ol>

    <details class="pa-preview">
      <summary>{% if ko %}생성될 파일 미리보기{% else %}Preview file{% endif %}</summary>
      <p class="pa-path">-</p>
      <pre>-</pre>
    </details>
  </form>
</dialog>
<script src="{{ '/assets/js/gallery-admin.js' | relative_url }}" defer></script>
