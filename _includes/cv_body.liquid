{%- comment -%}
  이력(CV) 페이지 본문 (영문/국문 공용).
  내용: _cv_items/ 폴더 (항목 1개 = 파일 1개). section 값으로 구분하고, order_key 값이 큰 순(최근 순)으로 표시합니다.
{%- endcomment -%}
{%- assign lang = include.lang | default: 'en' -%}
{%- assign t = site.data.i18n[lang] -%}
{%- assign k_title = 'title_' | append: lang -%}
{%- assign k_org = 'org_' | append: lang -%}
{%- assign sections = 'education,experience,awards,memberships,editorial,teaching' | split: ',' -%}

{% if site.cms %}
<div class="cv-tools">
  <a class="admin-only pub-add" href="#" data-open-cv-admin><i class="fa-solid fa-plus"></i> {% if lang == 'ko' %}이력 항목 추가{% else %}Add CV item{% endif %}</a>
</div>
{% endif %}

<div class="cvx">
  {%- for sec in sections %}
  {%- assign items = site.cv_items | where: 'section', sec | sort: 'order_key' | reverse -%}
  {%- if items.size > 0 %}
  <section class="cvx-block" id="{{ sec }}">
    <h2>{{ t[sec] }}</h2>
    {%- if sec == 'teaching' %}
    <ul class="cvx-courses">
      {%- for c in items %}
      <li>{{ c[k_title] }}</li>
      {%- endfor %}
    </ul>
    {%- else %}
    <ul class="cvx-list">
      {%- for e in items %}
      <li><span class="cvx-when">{{ e.period | replace: 'present', t.present }}</span><div><strong>{{ e[k_title] }}</strong><span>{{ e[k_org] }}</span></div></li>
      {%- endfor %}
    </ul>
    {%- endif %}
  </section>
  {%- endif %}
  {%- endfor %}
</div>

{% include cv_admin.liquid lang=lang %}
