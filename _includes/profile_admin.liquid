{%- comment -%}
  관리자용 소개(About) 수정 창. About 페이지를 ?admin=1 로 열면 [소개 수정] 버튼이 보입니다.
  [GitHub에서 저장] → 새 profile.yml 내용이 클립보드에 복사되고 GitHub 편집 화면이 열림 → 전체 선택 후 붙여넣기 → Commit changes
{%- endcomment -%}
{%- assign ko = false -%}{%- if include.lang == 'ko' -%}{%- assign ko = true -%}{%- endif -%}
<script type="application/json" id="profileData">{{ site.data.profile | jsonify }}</script>
<dialog id="profileAdmin" class="pa-dialog pa-wide-dialog" data-repo="{{ site.github_repo }}" data-branch="{{ site.github_branch | default: 'main' }}" data-lang="{{ include.lang }}">
  <form method="dialog" class="pa-form" id="profileAdminForm">
    <header class="pa-head">
      <h3>{% if ko %}소개 수정{% else %}Edit About{% endif %}</h3>
      <button type="button" class="pa-x" data-close aria-label="Close">&times;</button>
    </header>

    <h4 class="pa-sub">{% if ko %}소개글{% else %}Biography{% endif %}</h4>
    <fieldset class="pa-fields">
      <label class="pa-wide">{% if ko %}소개글 (영문) — **굵게**, *기울임* 사용 가능, 빈 줄로 문단 구분{% else %}Biography (English){% endif %}<textarea name="bio_en" rows="7"></textarea></label>
      <label class="pa-wide">{% if ko %}소개글 (국문){% else %}Biography (Korean){% endif %}<textarea name="bio_ko" rows="7"></textarea></label>
    </fieldset>

    <h4 class="pa-sub">{% if ko %}직위 · 소속{% else %}Position{% endif %}</h4>
    <fieldset class="pa-fields">
      <label>{% if ko %}이름 (영문){% else %}Name (English){% endif %}<input name="name_en"></label>
      <label>{% if ko %}이름 (국문){% else %}Name (Korean){% endif %}<input name="name_ko"></label>
      <label>{% if ko %}직위 (영문){% else %}Title (English){% endif %}<input name="title_en"></label>
      <label>{% if ko %}직위 (국문){% else %}Title (Korean){% endif %}<input name="title_ko"></label>
      <label>{% if ko %}학과 (영문){% else %}Department (English){% endif %}<input name="department_en"></label>
      <label>{% if ko %}학과 (국문){% else %}Department (Korean){% endif %}<input name="department_ko"></label>
      <label>{% if ko %}소속 (영문){% else %}University (English){% endif %}<input name="university_en"></label>
      <label>{% if ko %}소속 (국문){% else %}University (Korean){% endif %}<input name="university_ko"></label>
      <label>{% if ko %}임용 연도{% else %}Faculty since{% endif %}<input name="faculty_since" type="number"></label>
      <label>{% if ko %}프로필 사진 경로{% else %}Photo path{% endif %}<input name="photo"></label>
    </fieldset>

    <h4 class="pa-sub">{% if ko %}연락처{% else %}Contact{% endif %}</h4>
    <fieldset class="pa-fields">
      <label class="pa-wide">{% if ko %}주소 (영문){% else %}Address (English){% endif %}<input name="address_en"></label>
      <label class="pa-wide">{% if ko %}주소 (국문){% else %}Address (Korean){% endif %}<input name="address_ko"></label>
      <label>{% if ko %}전화{% else %}Phone{% endif %}<input name="phone"></label>
      <label>{% if ko %}팩스{% else %}Fax{% endif %}<input name="fax"></label>
      <label class="pa-wide">{% if ko %}이메일{% else %}Email{% endif %}<input name="email" type="email"></label>
      <label class="pa-wide">Google Scholar<input name="scholar" type="url"></label>
      <label class="pa-wide">ResearchGate<input name="researchgate" type="url"></label>
    </fieldset>

    <h4 class="pa-sub">{% if ko %}연구 분야{% else %}Research interests{% endif %}</h4>
    <div id="paResearch" class="pa-research"></div>
    <button type="button" class="pa-btn" data-add-research><i class="fa-solid fa-plus"></i> {% if ko %}연구 분야 추가{% else %}Add research area{% endif %}</button>

    <details class="pa-preview">
      <summary>{% if ko %}생성될 파일 미리보기{% else %}Preview file{% endif %}</summary>
      <p class="pa-path">_data/profile.yml</p>
      <pre>-</pre>
    </details>

    <p class="pa-note">{% if ko %}[GitHub에서 저장]을 누르면 새 내용이 <b>자동으로 복사</b>되고 GitHub 편집 화면이 열립니다. 편집 화면에서 <b>Ctrl+A</b>(전체 선택) → <b>Ctrl+V</b>(붙여넣기) → <b>Commit changes</b>. 3~5분 뒤 반영됩니다.{% else %}[Save on GitHub] copies the new content and opens GitHub's editor. There: <b>Ctrl+A</b> → <b>Ctrl+V</b> → <b>Commit changes</b>.{% endif %}</p>

    <footer class="pa-actions">
      <button type="button" class="pa-btn ghost" data-download>{% if ko %}파일 다운로드{% else %}Download file{% endif %}</button>
      <button type="submit" class="pa-btn primary">{% if ko %}GitHub에서 저장{% else %}Save on GitHub{% endif %} <i class="fa-brands fa-github"></i></button>
    </footer>
  </form>
</dialog>

<template id="paResearchTpl">
  <fieldset class="pa-fields pa-research-item">
    <label>{% if ko %}제목 (영문){% else %}Title (English){% endif %}<input data-k="title_en"></label>
    <label>{% if ko %}제목 (국문){% else %}Title (Korean){% endif %}<input data-k="title_ko"></label>
    <label class="pa-wide">{% if ko %}설명 (영문){% else %}Description (English){% endif %}<textarea data-k="desc_en" rows="2"></textarea></label>
    <label class="pa-wide">{% if ko %}설명 (국문){% else %}Description (Korean){% endif %}<textarea data-k="desc_ko" rows="2"></textarea></label>
    <label>{% if ko %}아이콘 (Font Awesome){% else %}Icon (Font Awesome){% endif %}<input data-k="icon" placeholder="fa-solid fa-satellite"></label>
    <label class="pa-check pa-remove"><input type="checkbox" data-remove> {% if ko %}이 연구 분야 삭제{% else %}Remove this item{% endif %}</label>
  </fieldset>
</template>
<script src="{{ '/assets/js/profile-admin.js' | relative_url }}" defer></script>
