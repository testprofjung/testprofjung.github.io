{%- comment -%} 연구실적 페이지 본문 (영문/국문 공용). 논문: _papers/, 특허: _patents/ {%- endcomment -%}
{%- assign lang = include.lang | default: 'en' -%}
{%- assign t = site.data.i18n[lang] -%}
{%- assign papers = site.papers | sort: 'date' | reverse | group_by: 'year' -%}
{%- assign patents = site.patents | sort: 'date' | reverse | group_by: 'year' -%}

<nav class="pub-tabs">
  <a href="?go=articles" data-go="articles">{{ t.articles }} <span>{{ site.papers.size }}</span></a>
  <a href="?go=patents" data-go="patents">{{ t.patents }} <span>{{ site.patents.size }}</span></a>
  <a class="admin-only pub-add" href="#" data-open-pub-admin><i class="fa-solid fa-plus"></i> {% if lang == 'ko' %}논문·특허 추가{% else %}Add paper / patent{% endif %}</a>
</nav>

{% if site.bib_search %}
<script src="{{ '/assets/js/bibsearch.js' | relative_url | bust_file_cache }}" type="module"></script>
<input type="text" id="bibsearch" spellcheck="false" autocomplete="off" class="search bibsearch-form-input" placeholder="{{ t.search_placeholder }}">
{% endif %}

<div class="publications">
  <h2 class="pub-section" id="articles">{{ t.articles }}</h2>
  {%- for g in papers %}
  <h2 class="bibliography">{{ g.name }}</h2>
  <ol class="bibliography">
    {%- for p in g.items %}
    {% include paper.liquid p=p %}
    {%- endfor %}
  </ol>
  {%- endfor %}

  <h2 class="pub-section" id="patents">{{ t.patents }}</h2>
  {%- for g in patents %}
  <h2 class="bibliography">{{ g.name }}</h2>
  <ol class="bibliography">
    {%- for p in g.items %}
    {% include patent.liquid p=p lang=lang %}
    {%- endfor %}
  </ol>
  {%- endfor %}
</div>

{% include pub_admin.liquid lang=lang %}

<script>
  // 탭 이동: # 주소를 쓰면 al-folio 검색창에 그 글자가 들어가므로, ?go= 와 스크롤로 이동
  (function () {
    function go(id) {
      var el = document.getElementById(id);
      if (el) el.scrollIntoView({ behavior: "smooth", block: "start" });
    }
    document.querySelectorAll("[data-go]").forEach(function (a) {
      a.addEventListener("click", function (e) { e.preventDefault(); go(a.getAttribute("data-go")); });
    });
    var target = null;
    var m = /[?&]go=([a-z]+)/.exec(location.search);
    if (m) target = m[1];

    // 주소 끝의 #articles / #patents 는 검색어로 쓰이지 않도록 지우고 해당 위치로 이동만 함
    // (이 스크립트가 al-folio 검색 스크립트보다 먼저 실행되므로 먼저 가로챌 수 있음)
    function sectionHash() {
      var h = (location.hash || "").replace(/^#/, "");
      return h === "articles" || h === "patents" ? h : null;
    }
    function clearHash() {
      history.replaceState(null, "", location.pathname + location.search);
    }
    var h0 = sectionHash();
    if (h0) { target = h0; clearHash(); }
    if (target) window.addEventListener("load", function () { go(target); });

    window.addEventListener("hashchange", function (e) {
      var h = sectionHash();
      if (!h) return;
      e.stopImmediatePropagation(); // 검색 스크립트의 hashchange 처리를 막음
      clearHash();
      go(h);
    });
  })();
</script>
